#!/bin/sh

echo "------run rc.modules file-----"
#insmod sound modules
#echo "insmod sound modules"
#/sbin/insmod /lib/modules/3.4.39/snd-seq-device.ko
#/sbin/insmod /lib/modules/3.4.39/snd-mixer-oss.ko
#/sbin/insmod /lib/modules/3.4.39/snd-pcm-oss.ko

echo "------  insmod gslX680new modules start --------"
#touchscreen
insmod /lib/modules/4.9.191/gslX680new.ko

echo "----- set usb hub -------------"
#enable usb hub
echo 412 > /sys/class/gpio/export
echo out > /sys/class/gpio/gpio412/direction
echo 0 > /sys/class/gpio/gpio412/value
#set usb host
#cat /sys/devices/platform/soc/usbc0/usb_host
